{
  "name": "@delinoio/delcore-api",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "ci:format": "node ../../scripts/ci/check-go-format.mjs servers/delcore-api",
    "ci:vet": "go vet ./...",
    "ci:build": "go build ./cmd/delcore-api ./cmd/sample-client",
    "ci:unit": "go test -count=1 ./...",
    "ci:integration": "go test -count=1 -race -tags=integration ./...",
    "ci:oci": "node ../../scripts/ci/from-root.mjs docker build -f servers/delcore-api/Dockerfile -t delcore-api:validation ."
  }
}
