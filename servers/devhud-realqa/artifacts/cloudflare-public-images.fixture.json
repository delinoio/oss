{
  "artifact_only": true,
  "provider": "cloudflare",
  "zone_origin": "assets.realqa.deli.dev",
  "rules": [
    {
      "description": "RealQA public image managed WAF fixture",
      "phase": "http_request_firewall_managed",
      "action": "execute",
      "expression": "(http.request.method eq \"GET\" and starts_with(http.request.uri.path, \"/i/\"))",
      "managed_ruleset": "cloudflare_managed_ruleset"
    },
    {
      "description": "RealQA public image GETs: 300 per minute per source IP",
      "phase": "http_ratelimit",
      "action": "block",
      "expression": "(http.request.method eq \"GET\" and starts_with(http.request.uri.path, \"/i/\"))",
      "characteristics": [
        "ip.src"
      ],
      "requests_per_period": 300,
      "period_seconds": 60,
      "mitigation_timeout_seconds": 60
    }
  ],
  "provisions_resources": false,
  "deploys_resources": false
}
