# SPDX-License-Identifier: Apache-2.0
# Copy to .env in this directory for pnpm dev; chmod 600. Never commit it.
# Internal HTTP listener. An existing reverse proxy must provide public HTTPS.
TAIROUTER_LISTEN_ADDR=127.0.0.1:8080
TAIROUTER_PUBLIC_URL=http://127.0.0.1:4173
# Optional built SPA directory (production image: /app/console).
TAIROUTER_CONSOLE_DIR=
TAIROUTER_DATABASE_URL=postgres://tairouter:REPLACE_PASSWORD@127.0.0.1:5432/tairouter
# Register PUBLIC_URL/auth/callback. Issuer must match discovery exactly.
TAIROUTER_OIDC_ISSUER=https://identity.example.com
TAIROUTER_OIDC_CLIENT_ID=REPLACE_CLIENT_ID
TAIROUTER_OIDC_CLIENT_SECRET=REPLACE_CLIENT_SECRET
# Inject each 32-byte master key as standard base64. Retain old backup keys separately.
TAIROUTER_ENCRYPTION_ACTIVE_KEY=v1
TAIROUTER_ENCRYPTION_KEYS={"v1":"REPLACE_BASE64_32_BYTE_KEY"}
# Exact verified OIDC identities. Organization roles do not grant operator authority.
TAIROUTER_OPERATORS=[]
# STARTTLS is required outside loopback. Credentials must be supplied together.
TAIROUTER_SMTP_ADDR=127.0.0.1:1025
TAIROUTER_SMTP_FROM=router@example.com
TAIROUTER_SMTP_USERNAME=
TAIROUTER_SMTP_PASSWORD=
# Private R2 S3 endpoint; never a public bucket or a cached custom domain.
TAIROUTER_R2_ENDPOINT=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
TAIROUTER_R2_BUCKET=REPLACE_BUCKET
TAIROUTER_R2_ACCESS_KEY_ID=REPLACE_ACCESS_KEY_ID
TAIROUTER_R2_SECRET_ACCESS_KEY=REPLACE_SECRET_ACCESS_KEY
# Optional OTLP/HTTP collector. Protect /metrics at the public reverse proxy.
# Leave empty when no development collector is running.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional Google Antigravity OAuth application. Both values are required for login/refresh.
TAIROUTER_GOOGLE_OAUTH_CLIENT_ID=
TAIROUTER_GOOGLE_OAUTH_CLIENT_SECRET=
