# Optional OSS-only, contributor-owned Logto issuer and application identifiers.
# Copy this file to .env only after creating your own applications in local Logto.
# The issuer must exactly match apps/devhud-admin/.env when either file overrides it.
# Values must be non-empty public configuration; they are not shared team secrets.
# Non-loopback URLs must use HTTPS. The eight upload names below are all-or-none.
DEVHUD_LOGTO_ISSUER=http://localhost:3001/oidc
DEVHUD_LOGTO_AUDIENCE=urn:devhud:replace-with-your-local-api-resource
DEVHUD_LOGTO_DESKTOP_CLIENT_ID=replace-with-your-local-desktop-client-id
DEVHUD_LOGTO_IOS_CLIENT_ID=replace-with-your-local-ios-client-id
DEVHUD_LOGTO_ANDROID_CLIENT_ID=replace-with-your-local-android-client-id
DEVHUD_LOGTO_ADMIN_CLIENT_ID=replace-with-your-local-admin-client-id

# Team development owns the remaining names in Infisical. These comments are the
# service contract, not a file to populate with credentials.
# DEVHUD_DATABASE_URL=postgres://devhud:devhud@127.0.0.1:5432/devhud?sslmode=disable
# DEVHUD_PUBLIC_API_URL=http://127.0.0.1:46307
# DEVHUD_ADMIN_REDIRECT_URI=http://localhost:46306/auth/callback
# DEVHUD_PUBLIC_ASSET_BASE_URL=http://127.0.0.1:46307
# DEVHUD_IDENTITY_HMAC_KEYS=base64-encoded-key-of-at-least-32-bytes
# DEVHUD_R2_ENDPOINT=https://replace-with-development-r2-endpoint
# DEVHUD_R2_ACCESS_KEY_ID=replace-with-development-access-key-id
# DEVHUD_R2_SECRET_ACCESS_KEY=replace-with-development-secret-access-key
# DEVHUD_R2_STAGING_BUCKET=replace-with-development-staging-bucket
# DEVHUD_R2_PUBLIC_BUCKET=replace-with-development-public-bucket
# DEVHUD_CLOUDFLARE_API_TOKEN=replace-with-development-api-token
# DEVHUD_CLOUDFLARE_ZONE_ID=replace-with-development-zone-id
# DEVHUD_CLOUDFLARE_RATE_LIMIT_RULE_ID=replace-with-development-rule-id
