      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/crates/clibox/**", "$TURBO_ROOT$/Cargo.toml", "$TURBO_ROOT$/Cargo.lock", "$TURBO_ROOT$/rust-toolchain"],
      "outputs": []
