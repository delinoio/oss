{
  "extends": [
    "//"
  ],
  "tasks": {
    "build": {
      "dependsOn": [],
      "cache": false,
      "passThroughEnv": [
        "CARGO_HOME",
        "RUSTUP_HOME",
        "REACT_FORGE_NATIVE_PROFILE"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "passThroughEnv": [
        "npm_execpath",
        "REACT_FORGE_SKIP_SCENE_TESTS"
      ]
    },
    "test:render": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "passThroughEnv": [
        "REACT_FORGE_SOFFICE",
        "REACT_FORGE_PDFTOPPM",
        "REACT_FORGE_PYTHON"
      ]
    },
    "benchmark": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "test:scenes": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "passThroughEnv": [
        "REACT_FORGE_BLENDER",
        "CARGO_HOME",
        "RUSTUP_HOME"
      ]
    }
  }
}
