{
  "name": "@delino/react-forge",
  "version": "0.1.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./pptx": {
      "types": "./dist/pptx.d.ts",
      "import": "./dist/pptx.js",
      "require": "./dist/pptx.js"
    },
    "./docx": {
      "types": "./dist/docx.d.ts",
      "import": "./dist/docx.js",
      "require": "./dist/docx.js"
    },
    "./xlsx": {
      "types": "./dist/xlsx.d.ts",
      "import": "./dist/xlsx.js",
      "require": "./dist/xlsx.js"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "import": "./dist/pdf.js",
      "require": "./dist/pdf.js"
    },
    "./figma": {
      "types": "./dist/figma.d.ts",
      "import": "./dist/figma.js",
      "require": "./dist/figma.js"
    },
    "./glb": {
      "types": "./dist/glb.d.ts",
      "import": "./dist/glb.js",
      "require": "./dist/glb.js"
    },
    "./fbx": {
      "types": "./dist/fbx.d.ts",
      "import": "./dist/fbx.js",
      "require": "./dist/fbx.js"
    }
  },
  "bin": {
    "react-forge": "./bin/react-forge.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build": "pnpm build:native && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm typecheck",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx scripts/package.test.mjs",
    "cli": "node bin/react-forge.mjs",
    "test:render": "node scripts/render-check.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "package:main": "node scripts/package.mjs main",
    "package:native": "node scripts/package.mjs native",
    "package:verify": "node scripts/package.mjs verify",
    "test:package": "node scripts/install-smoke.mjs",
    "test:scenes": "node scripts/render-scenes.mjs",
    "example:scenes": "node --import tsx scripts/generate-scene-examples.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "esbuild": "0.28.2",
    "react": "19.2.8",
    "react-reconciler": "0.33.0",
    "tsx": "4.20.6",
    "uuid": "11.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-reconciler": "0.32.3",
    "gltf-validator": "2.0.0-dev.3.10",
    "three": "0.186.1",
    "typescript": "5.9.3"
  }
}
