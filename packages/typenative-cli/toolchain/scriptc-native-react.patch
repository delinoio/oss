diff --git a/packages/compiler/src/frontend/strict-arguments.test.ts b/packages/compiler/src/frontend/strict-arguments.test.ts
new file mode 100644
index 00000000..93a85781
--- /dev/null
+++ b/packages/compiler/src/frontend/strict-arguments.test.ts
@@ -0,0 +1,120 @@
+import { mkdtempSync, mkdirSync, rmSync, writeFileSync } from "node:fs";
+import { execFileSync } from "node:child_process";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { expect, test } from "vitest";
+import { analyze, compile } from "../index.js";
+
+const cases = [
+  [
+    "file directive",
+    '"use strict"; function read(value) { value = 9; return arguments[0]; } console.log(read(3));',
+    false,
+  ],
+  [
+    "function directive",
+    'function read(value) { "use strict"; value = 9; return arguments[0]; } console.log(read(3));',
+    false,
+  ],
+  [
+    "inherited directive",
+    'function outer() { "use strict"; return function read(value) { value = 9; return arguments[0]; }; } console.log(outer()(3));',
+    false,
+  ],
+  [
+    "sloppy function",
+    "function read(value) { value = 9; return arguments[0]; } console.log(read(3));",
+    true,
+  ],
+  [
+    "late string",
+    'function read(value) { value = 9; "use strict"; return arguments[0]; } console.log(read(3));',
+    true,
+  ],
+  [
+    "escaped directive",
+    String.raw`"use\x20strict"; function read(value) { value = 9; return arguments[0]; } console.log(read(3));`,
+    true,
+  ],
+  [
+    "unrelated directive",
+    'function other() { "use strict"; } function read(value) { value = 9; return arguments[0]; } console.log(read(3));',
+    true,
+  ],
+] as const;
+
+test.each(cases)("CommonJS arguments: %s", (_name, source, refused) => {
+  const directory = mkdtempSync(join(tmpdir(), "scriptc-strict-arguments-"));
+  try {
+    const entry = join(directory, "entry.cjs");
+    writeFileSync(entry, source);
+    const result = analyze(entry);
+    const diagnostics = [...result.coverage.diagnostics, ...(result.coverage.runtimeFences ?? [])];
+    expect(
+      diagnostics.some((diagnostic) =>
+        diagnostic.message.includes("sloppy-mode parameter aliases"),
+      ),
+    ).toBe(refused);
+    if (!refused) expect(diagnostics).toEqual([]);
+  } finally {
+    rmSync(directory, { recursive: true, force: true });
+  }
+});
+
+const nativeCases = [
+  [
+    "file strict arguments",
+    '"use strict"; function read(value) { value = 9; return arguments[0]; } console.log(read(3));',
+  ],
+  [
+    "local strict arguments",
+    'function read(value) { "use strict"; value = 9; return arguments[0]; } console.log(read(3));',
+  ],
+  [
+    "inherited strict arguments",
+    'function outer() { "use strict"; return function read(value) { value = 9; return arguments[0]; }; } console.log(outer()(3));',
+  ],
+  [
+    "hoisted for-in writes",
+    '"use strict"; function keys(object) { for (key in object) console.log(key); var key = 2; console.log(key); } keys({a: 1, b: 2});',
+  ],
+  [
+    "captured for-in writes",
+    '"use strict"; function keys(object) { var key = 2; function walk() { for (key in object) console.log(key); } walk(); console.log(key); } keys({a: 1});',
+  ],
+] as const;
+
+test.each(nativeCases)(
+  "native matches Node: %s",
+  async (_name, source) => {
+    const directory = mkdtempSync(join(tmpdir(), "scriptc-native-arguments-"));
+    try {
+      const entry = join(directory, "entry.cjs");
+      const output = join(directory, process.platform === "win32" ? "app.exe" : "app");
+      writeFileSync(entry, source);
+      let buildEntry = entry;
+      if (_name.includes("for-in")) {
+        const pkg = join(directory, "node_modules", "loop-fixture");
+        mkdirSync(pkg, { recursive: true });
+        writeFileSync(
+          join(pkg, "package.json"),
+          JSON.stringify({ name: "loop-fixture", main: "index.js" }),
+        );
+        writeFileSync(join(pkg, "index.js"), source);
+        buildEntry = join(directory, "main.ts");
+        writeFileSync(buildEntry, 'import "loop-fixture";');
+      }
+      const result = await compile(buildEntry, {
+        outDir: directory,
+        outPath: output,
+        npmStatic: ["loop-fixture"],
+      });
+      expect(result.ok, JSON.stringify(result)).toBe(true);
+      const expected = execFileSync(process.execPath, [entry], { encoding: "utf8" });
+      expect(execFileSync(output, [], { encoding: "utf8" })).toBe(expected);
+    } finally {
+      rmSync(directory, { recursive: true, force: true });
+    }
+  },
+  60000,
+);
