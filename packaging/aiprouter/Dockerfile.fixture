FROM golang:1.26.10-bookworm AS build
WORKDIR /src
COPY scripts/aiprouter/fixture ./fixture
RUN CGO_ENABLED=0 go build -trimpath -o /fixture ./fixture/main.go
FROM debian:bookworm-slim
COPY --from=build /fixture /usr/local/bin/aiprouter-fixture
COPY LICENSE NOTICE /usr/share/doc/aiprouter/
COPY --from=build /usr/local/go/LICENSE /usr/share/doc/aiprouter/GO-LICENSE
USER 65532:65532
ENTRYPOINT ["aiprouter-fixture"]
