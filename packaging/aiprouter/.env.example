# Copy to .env in this directory; chmod 600. Never commit the populated file.
# Passwords in DATABASE_URL must be URL-safe. Generate random hexadecimal values.
POSTGRES_PASSWORD=replace-with-random-hex
GRAFANA_ADMIN_PASSWORD=replace-with-random-secret
AIPROUTER_IMAGE=aiprouter:local
AIPROUTER_PUBLIC_URL=http://127.0.0.1:8080
AIPROUTER_LISTEN_ADDR=127.0.0.1:8080
AIPROUTER_DATABASE_URL=postgres://aiprouter:replace-with-random-hex@127.0.0.1:55432/aiprouter?sslmode=disable
AIPROUTER_OIDC_ISSUER=http://127.0.0.1:18090
AIPROUTER_OIDC_CLIENT_ID=aiprouter-fixture
AIPROUTER_OIDC_CLIENT_SECRET=replace-with-client-secret
# JSON mapping of version IDs to base64-encoded random 32-byte master keys.
AIPROUTER_ENCRYPTION_KEYS={"v1":"replace-with-base64-key"}
AIPROUTER_ENCRYPTION_ACTIVE_KEY=v1
AIPROUTER_OPERATORS=[]
AIPROUTER_SMTP_ADDR=127.0.0.1:1025
AIPROUTER_SMTP_FROM=aiprouter@example.invalid
AIPROUTER_SMTP_USERNAME=
AIPROUTER_SMTP_PASSWORD=
# R2 is required for generated images. Use real account values outside fixtures.
AIPROUTER_R2_ENDPOINT=https://r2.example.invalid
AIPROUTER_R2_BUCKET=aiprouter-fixture
AIPROUTER_R2_ACCESS_KEY_ID=replace-with-r2-access-key
AIPROUTER_R2_SECRET_ACCESS_KEY=replace-with-r2-secret

# Optional operator-owned OTLP/HTTP collector. Empty disables export.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional Google Antigravity OAuth application. Both values are required for login/refresh.
AIPROUTER_GOOGLE_OAUTH_CLIENT_ID=
AIPROUTER_GOOGLE_OAUTH_CLIENT_SECRET=
