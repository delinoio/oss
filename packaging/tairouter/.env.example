# Copy to .env in this directory; chmod 600. Never commit the populated file.
# Passwords in DATABASE_URL must be URL-safe. Generate random hexadecimal values.
POSTGRES_PASSWORD=replace-with-random-hex
GRAFANA_ADMIN_PASSWORD=replace-with-random-secret
TAIROUTER_IMAGE=tairouter:local
TAIROUTER_PUBLIC_URL=http://127.0.0.1:8080
TAIROUTER_LISTEN_ADDR=127.0.0.1:8080
TAIROUTER_DATABASE_URL=postgres://tairouter:replace-with-random-hex@127.0.0.1:55432/tairouter?sslmode=disable
TAIROUTER_OIDC_ISSUER=http://127.0.0.1:18090
TAIROUTER_OIDC_CLIENT_ID=tairouter-fixture
TAIROUTER_OIDC_CLIENT_SECRET=replace-with-client-secret
# JSON mapping of version IDs to base64-encoded random 32-byte master keys.
TAIROUTER_ENCRYPTION_KEYS={"v1":"replace-with-base64-key"}
TAIROUTER_ENCRYPTION_ACTIVE_KEY=v1
TAIROUTER_OPERATORS=[]
TAIROUTER_SMTP_ADDR=127.0.0.1:1025
TAIROUTER_SMTP_FROM=tairouter@example.invalid
TAIROUTER_SMTP_USERNAME=
TAIROUTER_SMTP_PASSWORD=
# R2 is required for generated images. Use real account values outside fixtures.
TAIROUTER_R2_ENDPOINT=https://r2.example.invalid
TAIROUTER_R2_BUCKET=tairouter-fixture
TAIROUTER_R2_ACCESS_KEY_ID=replace-with-r2-access-key
TAIROUTER_R2_SECRET_ACCESS_KEY=replace-with-r2-secret

# Optional operator-owned OTLP/HTTP collector. Empty disables export.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional Google Antigravity OAuth application. Both values are required for login/refresh.
TAIROUTER_GOOGLE_OAUTH_CLIENT_ID=
TAIROUTER_GOOGLE_OAUTH_CLIENT_SECRET=
