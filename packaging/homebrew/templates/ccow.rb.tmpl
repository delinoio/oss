class Ccow < Formula
  desc "Copy-on-write build caches for Git worktrees"
  homepage "https://oss.delino.io/cachecow/"
  url "__DARWIN_ARM64_URL__"
  version "__VERSION__"
  sha256 "__DARWIN_ARM64_SHA256__"
  license "Apache-2.0"

  depends_on arch: :arm64
  depends_on macos: :sequoia

  def install
    bin.install "ccow"
    prefix.install "LICENSE", "NOTICE"
  end

  test do
    assert_equal "ccow #{version}", shell_output("#{bin}/ccow --version").strip
    assert_match "Usage:", shell_output("#{bin}/ccow --help")
    assert_match "Apache License", (prefix/"LICENSE").read
  end
end
