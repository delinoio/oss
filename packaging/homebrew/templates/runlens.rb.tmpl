class Runlens < Formula
  desc "Filesystem diagnostics for developer commands"
  homepage "https://runlens.delino.io"
  version "__VERSION__"
  license "MIT"

  on_macos do
    if Hardware::CPU.intel?
      url "__DARWIN_AMD64_URL__"
      sha256 "__DARWIN_AMD64_SHA256__"
    else
      url "__DARWIN_ARM64_URL__"
      sha256 "__DARWIN_ARM64_SHA256__"
    end
  end

  on_linux do
    if Hardware::CPU.intel?
      url "__LINUX_AMD64_URL__"
      sha256 "__LINUX_AMD64_SHA256__"
    elsif Hardware::CPU.arm? && Hardware::CPU.is_64_bit?
      url "__LINUX_ARM64_URL__"
      sha256 "__LINUX_ARM64_SHA256__"
    else
      odie "runlens prebuilt distribution currently supports Linux amd64 and arm64 only"
    end
  end

  def install
    bin.install "runlens"
  end

  test do
    assert_predicate bin/"runlens", :exist?
    assert_match version.to_s, shell_output("#{bin}/runlens --version").strip
  end
end
