{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#proto:generate": {
      "inputs": [
        "buf.gen.yaml",
        "buf.yaml",
        "protos/devhud/v1/**",
        "package.json",
        "pnpm-lock.yaml"
      ],
      "outputs": [
        "protos/gen/**",
        "packages/devhud-api-client/src/gen/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "build:api"
      ],
      "cache": false,
      "env": [
        "CARGO_HOME",
        "DEVHUD_LOCAL_MODE",
        "DISPLAY",
        "RUSTUP_HOME",
        "XAUTHORITY",
        "XDG_RUNTIME_DIR"
      ],
      "persistent": true
    },
    "build:api": {
      "dependsOn": [
        "^build:api"
      ],
      "inputs": [
        ".env",
        "src/**",
        "**/*.proto",
        "**/*.go",
        "**/*.ts",
        "**/*.mts",
        "**/*.tsx",
        "tsconfig.json",
        "!**/e2e/",
        "!.next/**",
        "!*/**/*.test.ts",
        "!*/**/*.test.tsx",
        "!*/**/*.e2e.ts",
        "!*/**/*.e2e.tsx",
        "!*/**/*.cy.ts"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    },
    "build:frontend": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        "artifacts/**",
        "doc_build/**"
      ]
    },
    "build":{
      "dependsOn": [
        "^build",
        "build:api"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        "src/**",
        "**/*.proto",
        "**/*.go",
        "**/*.ts",
        "**/*.mts",
        "**/*.tsx",
        "tsconfig.json",
        "tsconfig.build.json",
        "!**/e2e/",
        "!.next/**",
        "!*/**/*.test.ts",
        "!*/**/*.test.tsx",
        "!*/**/*.e2e.ts",
        "!*/**/*.e2e.tsx",
        "!*/**/*.cy.ts"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "build/**",
        "artifacts/**",
        "doc_build/**"
      ]
    },
    "test": {},
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:unit": {},
    "test:components": {},
    "test:accessibility": {},
    "test:security": {},
    "test:adapters": {},
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    }
  }
}
