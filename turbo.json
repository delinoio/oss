{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "dependsOn": [
        "build:api"
      ],
      "cache": false,
      "persistent": true
    },
    "build:api":{
      "dependsOn": [
        "^build:api"
      ],
      "inputs": [
        ".env",
        "src/**",
        "**/*.proto",
        "**/*.go",
        "**/*.ts",
        "**/*.mts",
        "**/*.tsx",
        "tsconfig.json",
        "!**/e2e/",
        "!.next/**",
        "!*/**/*.test.ts",
        "!*/**/*.test.tsx",
        "!*/**/*.e2e.ts",
        "!*/**/*.e2e.tsx",
        "!*/**/*.cy.ts"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    },
    "build":{
      "dependsOn": [
        "^build",
        "build:api"
      ],
      "inputs": [
        ".env",
        "src/**",
        "**/*.proto",
        "**/*.go",
        "**/*.ts",
        "**/*.mts",
        "**/*.tsx",
        "tsconfig.json",
        "!**/e2e/",
        "!.next/**",
        "!*/**/*.test.ts",
        "!*/**/*.test.tsx",
        "!*/**/*.e2e.ts",
        "!*/**/*.e2e.tsx",
        "!*/**/*.cy.ts"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    },
    "test": {},
    "ci:realqa:proto": {
      "cache": false
    },
    "ci:realqa:frontend": {
      "cache": false
    },
    "ci:realqa:rust": {
      "cache": false
    },
    "ci:realqa:linux": {
      "cache": false
    },
    "ci:realqa:extension": {
      "cache": false
    },
    "ci:realqa:fixture-artifacts": {
      "cache": false,
      "outputs": [
        "build/realqa-fixtures/**"
      ]
    },
    "ci:realqa:settings": {
      "cache": false
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    }
  }
}
