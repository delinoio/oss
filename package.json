{
  "name": "delinoio-oss-workspace",
  "packageManager": "pnpm@10.26.2",
  "private": true,
  "scripts": {
    "prepare": "./scripts/install-git-hooks.sh && ./scripts/prepare-apps.sh",
    "predev": "./scripts/generate-proto.sh",
    "dev": "./scripts/dev.sh",
    "build": "turbo build",
    "generate:proto": "./scripts/generate-proto.sh",
    "check:proto": "./scripts/check-proto.sh",
    "ci:realqa:proto": "turbo run ci:realqa:proto --filter=@delinoio/devhud-realqa-connect",
    "ci:realqa:go:unit": "go test -count=1 ./servers/devhud-realqa/...",
    "ci:realqa:go:integrations": "go test -count=1 ./servers/devhud-realqa/internal/github ./servers/devhud-realqa/internal/imageassets ./servers/devhud-realqa/internal/delibase ./servers/devhud-realqa/artifacts",
    "ci:realqa:go:billing-race": "go test -race -count=1 -run 'TestPostgreSQLPresetReplayRevisionRolesAndDeletion' ./servers/devhud-realqa/internal/service",
    "ci:realqa:frontend": "turbo run ci:realqa:frontend --filter=devhud",
    "ci:realqa:rust": "turbo run ci:realqa:rust --filter=devhud",
    "ci:realqa:linux": "turbo run ci:realqa:linux --filter=devhud",
    "ci:realqa:extension": "turbo run ci:realqa:extension --filter=devhud",
    "ci:realqa:fixture-artifacts": "turbo run ci:realqa:fixture-artifacts --filter=devhud",
    "ci:realqa:delidev-settings": "turbo run ci:realqa:settings --filter=delidev-app",
    "ci:realqa:safety": "node scripts/check-realqa-ci-safety.mjs",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "turbo format"
  },
  "pnpm": {
    "overrides": {
      "@expo/cli>tar": "7.5.22",
      "@expo/cli>undici": "6.27.0",
      "@expo/plist>@xmldom/xmldom": "0.8.13",
      "@stoplight/spectral-core>minimatch": "3.1.5",
      "@xmldom/xmldom": "0.8.13",
      "axios": "1.16.0",
      "basic-ftp": "5.3.1",
      "brace-expansion@>=1.0.0 <1.1.16": "1.1.17",
      "brace-expansion@>=2.0.0 <2.1.2": "5.0.8",
      "brace-expansion@>=5.0.0 <5.0.8": "5.0.8",
      "engine.io>cookie": "0.7.2",
      "esbuild": "0.28.1",
      "express": "4.21.2",
      "expo-dev-launcher>ajv": "8.18.0",
      "fast-uri": "3.1.4",
      "follow-redirects": "1.16.0",
      "form-data": "4.0.6",
      "http-proxy-agent>@tootallnate/once": "3.0.1",
      "ip-address": "10.1.1",
      "js-yaml": "4.3.0",
      "lodash": "4.18.1",
      "path-to-regexp": "0.1.13",
      "postcss": "8.5.18",
      "qs": "6.15.2",
      "shell-quote": "1.9.0",
      "uuid": "11.1.1",
      "ws@>=6.0.0 <6.2.4": "6.2.4",
      "ws@>=7.0.0 <7.5.11": "7.5.11",
      "ws@>=8.0.0 <8.21.0": "8.21.0"
    },
    "patchedDependencies": {
      "@bufbuild/protobuf@2.13.0": "patches/@bufbuild__protobuf@2.13.0.patch"
    }
  },
  "devDependencies": {
    "js-yaml": "4.3.0",
    "lefthook": "^2.1.4",
    "turbo": "^2.9.14"
  }
}
