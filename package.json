{
  "name": "delinoio-oss-workspace",
  "packageManager": "pnpm@10.26.2",
  "private": true,
  "scripts": {
    "prepare": "./scripts/install-git-hooks.sh && ./scripts/prepare-apps.sh",
    "dev": "./scripts/dev.sh",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "turbo format",
    "proto:generate": "buf generate",
    "proto:lint": "buf format --diff --exit-code && buf lint",
    "proto:breaking": "./scripts/check-proto-breaking.sh",
    "proto:fresh": "pnpm proto:generate && git diff --exit-code -- 'protos/gen' 'packages/devhud-api-client/src/gen' && test -z \"$(git ls-files --others --exclude-standard -- 'protos/gen' 'packages/devhud-api-client/src/gen')\"",
    "proto:check": "pnpm proto:lint && pnpm proto:breaking && pnpm proto:fresh"
  },
  "pnpm": {
    "overrides": {
      "@expo/cli>tar": "7.5.22",
      "@expo/cli>undici": "7.29.0",
      "@expo/plist>@xmldom/xmldom": "0.8.13",
      "@stoplight/spectral-core>minimatch": "3.1.5",
      "@xmldom/xmldom": "0.8.13",
      "axios": "1.16.0",
      "basic-ftp": "5.3.1",
      "brace-expansion@>=1.0.0 <1.1.16": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.2": "5.0.9",
      "brace-expansion@>=5.0.0 <5.0.8": "5.0.9",
      "engine.io>cookie": "0.7.2",
      "esbuild": "0.28.1",
      "express": "4.21.2",
      "expo-dev-launcher>ajv": "8.18.0",
      "fast-uri": "3.1.5",
      "follow-redirects": "1.16.0",
      "form-data": "4.0.6",
      "http-proxy-agent>@tootallnate/once": "3.0.1",
      "ip-address": "10.1.1",
      "js-yaml": "4.3.1",
      "lodash": "4.18.1",
      "path-to-regexp": "0.1.13",
      "postcss": "8.5.26",
      "qs": "6.15.2",
      "shell-quote": "1.9.0",
      "uuid": "11.1.1",
      "ws@>=6.0.0 <6.2.4": "6.2.6",
      "ws@>=7.0.0 <7.5.11": "7.5.11",
      "ws@>=8.0.0 <8.21.0": "8.21.0"
    }
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protoc-gen-es": "2.14.0",
    "@connectrpc/protoc-gen-connect-query": "2.3.1",
    "js-yaml": "4.3.1",
    "lefthook": "^2.1.4",
    "turbo": "^2.9.14"
  }
}
