{
  "name": "delinoio-oss-workspace",
  "packageManager": "pnpm@10.26.2",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "prepare": "./scripts/install-git-hooks.sh && ./scripts/prepare-apps.sh",
    "env:login": "node scripts/dev-environment/cli.mjs login",
    "env:doctor": "node scripts/dev-environment/cli.mjs doctor",
    "dev": "node scripts/dev-environment/cli.mjs start team",
    "dev:public-docs": "pnpm --filter public-docs dev",
    "dev:oss": "node scripts/dev-environment/cli.mjs start oss",
    "dev:oss:down": "node scripts/dev-environment/cli.mjs down",
    "test:dev-environment": "turbo run ci:environment ci:environment:turbo --filter=@delinoio/ci",
    "ci:affected": "turbo run",
    "ci:contracts": "turbo run ci:contracts --filter=@delinoio/ci",
    "ci:workflows": "turbo run ci:workflows --filter=@delinoio/ci",
    "ci:release-fixtures": "turbo run ci:release-fixtures --filter=@delinoio/ci",
    "ci:tools": "turbo run ci:tools --filter=@delinoio/ci",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "proto:generate": "buf generate",
    "proto:generate:cached": "turbo run //#proto:generate",
    "proto:lint": "turbo run ci:proto:lint ci:proto:format --filter=@delinoio/ci",
    "proto:breaking": "turbo run ci:proto:breaking --filter=@delinoio/ci",
    "proto:fresh": "turbo run ci:proto:fresh --filter=@delinoio/ci",
    "proto:check": "turbo run ci:proto:check --filter=@delinoio/ci",
    "dev:async-commit-hook": "pnpm --filter async-commit-hook dev"
  },
  "pnpm": {
    "overrides": {
      "@stoplight/spectral-core>minimatch": "3.1.5",
      "axios": "1.16.0",
      "basic-ftp": "5.3.1",
      "brace-expansion@>=1.0.0 <1.1.16": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.2": "5.0.12",
      "brace-expansion@>=5.0.0 <5.0.8": "5.0.12",
      "engine.io>cookie": "0.7.2",
      "esbuild": "0.28.2",
      "express": "4.22.3",
      "fast-uri": "3.1.8",
      "follow-redirects": "1.16.1",
      "form-data": "4.0.6",
      "http-proxy-agent>@tootallnate/once": "3.0.1",
      "ip-address": "10.7.3",
      "js-yaml": "4.3.2",
      "lodash": "4.18.1",
      "path-to-regexp": "0.1.13",
      "postcss": "8.5.28",
      "qs": "6.16.0",
      "react-router-dom": "7.18.4",
      "shell-quote": "1.9.0",
      "uuid": "11.1.1",
      "ws@>=6.0.0 <6.2.4": "6.2.6",
      "ws@>=7.0.0 <7.5.11": "7.5.13",
      "ws@>=8.0.0 <8.21.0": "8.21.3"
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protoc-gen-es": "2.14.0",
    "@connectrpc/protoc-gen-connect-query": "2.3.1",
    "clibox-prebuilt": "npm:@delino/clibox@0.1.6",
    "js-yaml": "4.3.2",
    "lefthook": "^2.1.4",
    "turbo": "^2.9.14"
  }
}
