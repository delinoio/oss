{
  "name": "@delinoio/ci",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "ci:workflows": "node from-root.mjs node scripts/ci/workflows.mjs",
    "ci:contracts": "node from-root.mjs node --test scripts/ci/*.test.mjs scripts/prebuilt-dependencies.test.mjs scripts/archive.test.mjs",
    "ci:tools": "node from-root.mjs node --test scripts/tools/*.test.cjs",
    "ci:release-fixtures": "node from-root.mjs node --test scripts/release/*.test.mjs",
    "ci:go:format": "node from-root.mjs node scripts/ci/check-go-format.mjs .",
    "ci:go:vet": "node from-root.mjs go vet ./...",
    "ci:go:test": "node from-root.mjs node scripts/ci/go-test.mjs",
    "ci:rust:fmt": "node from-root.mjs cargo fmt --all --check",
    "ci:rust:fmt-fixture": "node from-root.mjs node --test scripts/ci/rustfmt-cache.fixture.mjs",
    "ci:rust:clippy": "node from-root.mjs node scripts/ci/rust-affected.mjs clippy",
    "ci:pnport:companion": "node from-root.mjs cargo build --locked -p pnport -p pnport-preload",
    "ci:rust:test": "node from-root.mjs node scripts/ci/rust-affected.mjs test",
    "ci:forge:test": "node from-root.mjs cargo test -p forge-tree-doc -p forge-pptx -p delino-forge",
    "ci:forge:clippy": "node from-root.mjs cargo clippy -p forge-tree-doc -p forge-pptx -p delino-forge --all-targets -- -D warnings",
    "ci:forge:render": "node from-root.mjs cargo test -p delino-forge --test render -- --ignored",
    "ci:proto:launcher": "node from-root.mjs node --test scripts/ci/protocol-launcher.test.mjs",
    "ci:proto:lint": "node from-root.mjs buf lint",
    "ci:proto:format": "node from-root.mjs buf format --diff --exit-code",
    "ci:proto:breaking": "node from-root.mjs bash scripts/check-proto-breaking.sh",
    "ci:proto:fresh": "node from-root.mjs node scripts/ci/protocol-fresh.mjs",
    "ci:clibox:native": "node from-root.mjs cargo test --locked -p clibox -p clibox-config -p clibox-fspy -p clibox-system -p clibox-transform -p clibox-wait",
    "ci:runner": "node from-root.mjs node --test scripts/ci/run-affected.test.mjs",
    "ci:ach:native": "node from-root.mjs go test -race -count=1 ./cmds/async-commit-hook/...",
    "ci:ach:release": "node from-root.mjs node --test scripts/release/async-commit-hook.test.mjs",
    "ci:ach:package": "node from-root.mjs python3 scripts/release/build-async-commit-hook.py --output \"$RUNNER_TEMP/ach-release\"",
    "ci:rust:test:pnport": "node from-root.mjs node scripts/ci/rust-affected.mjs test",
    "ci:rust:selection-fixture": "node from-root.mjs node --test scripts/ci/rust-affected-live.test.mjs",
    "ci:go:quality": "node from-root.mjs node scripts/ci/go-quality.mjs",
    "ci:go:discovery": "node from-root.mjs node --test scripts/ci/go-affected.test.mjs",
    "ci:runmoor:unit": "node from-root.mjs go test -race -count=1 ./cmds/runmoor/...",
    "ci:runmoor:docker": "node from-root.mjs go test -count=1 -run TestDockerIntegration -v -timeout 10m ./cmds/runmoor/internal/runmoor",
    "ci:format": "node from-root.mjs node scripts/ci/format-changed.mjs",
    "format": "node from-root.mjs node scripts/ci/format-changed.mjs --write"
  }
}
