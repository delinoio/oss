#!/bin/sh
set -eu
if [ "$1" = remove ] || [ "$1" = deconfigure ]; then
  runtime_root="@RUNTIME_ROOT@"
  command -v getent >/dev/null
  command -v runuser >/dev/null
  getent passwd | while IFS=: read -r user _ uid _ _ home _; do
    case "$home" in
      /*) ;;
      *) continue ;;
    esac
    user_manifest="$home/.config/google-chrome/NativeMessagingHosts/io.delino.devhud.native_messaging.json"
    pairing_marker="$home/.local/share/io.delino.devhud/native-messaging-pairing-v1"
    if [ ! -e "$pairing_marker" ] && [ ! -L "$pairing_marker" ] && \
       [ ! -e "$user_manifest" ] && [ ! -L "$user_manifest" ]; then
      continue
    fi
    runtime="$runtime_root/$uid"
    if [ ! -S "$runtime/bus" ]; then
      echo "DevHud cannot remove the paired Native Messaging credentials for $user without an active user session" >&2
      exit 1
    fi
    runuser --user "$user" -- env \
      HOME="$home" \
      XDG_RUNTIME_DIR="$runtime" \
      DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" \
      "@HOST@" unregister "$user_manifest"
  done
  rm -f "@MANIFEST@"
fi
