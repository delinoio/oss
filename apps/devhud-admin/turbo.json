{
  "$schema": "https://turbo.build/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "build": {
      "cache": false
    },
    "build:frontend": {
      "cache": false
    },
    "build:embedded": {
      "cache": false
    },
    "verify:embedded": {
      "cache": false
    },
    "test:unit": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.nvmrc",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/rust-toolchain",
        "$TURBO_ROOT$/go.mod",
        "$TURBO_ROOT$/go.sum"
      ],
      "outputs": [],
      "env": [
        "CI_CACHE_CONTEXT"
      ]
    },
    "test:components": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.nvmrc",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/rust-toolchain",
        "$TURBO_ROOT$/go.mod",
        "$TURBO_ROOT$/go.sum"
      ],
      "outputs": [],
      "env": [
        "CI_CACHE_CONTEXT"
      ]
    },
    "test:port": {
      "cache": false,
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.nvmrc",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/rust-toolchain",
        "$TURBO_ROOT$/go.mod",
        "$TURBO_ROOT$/go.sum"
      ],
      "outputs": []
    },
    "ci:check": {
      "cache": false,
      "dependsOn": [
        "ci:typecheck",
        "test:unit",
        "test:components",
        "verify:embedded",
        "test:port"
      ]
    }
  }
}
