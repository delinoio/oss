{
  "name": "devhud-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/development.mjs serve",
    "build": "rsbuild build",
    "build:frontend": "pnpm build",
    "build:embedded": "pnpm --filter @delinoio/devhud-api-client build && pnpm build && node scripts/embedded-assets.mjs --write",
    "verify:embedded": "pnpm --filter @delinoio/devhud-api-client build && pnpm build && node scripts/verify-build.mjs && node scripts/embedded-assets.mjs --check",
    "typecheck": "pnpm --filter @delinoio/devhud-api-client build && tsc --noEmit",
    "lint": "pnpm typecheck",
    "test:unit": "vitest run src/api.test.ts src/auth.test.ts src/csp.test.ts",
    "test:components": "vitest run src/App.test.tsx src/Dialog.test.tsx",
    "test:accessibility": "vitest run src/App.test.tsx src/Dialog.test.tsx",
    "test": "pnpm lint && pnpm test:unit && pnpm test:components && pnpm test:accessibility && pnpm verify:embedded && pnpm test:port",
    "test:port": "node scripts/port-collision.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.0",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-web": "2.1.2",
    "@delinoio/devhud-api-client": "workspace:*",
    "@logto/browser": "2.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "unicode-case-folding": "1.1.1"
  },
  "devDependencies": {
    "@rsbuild/core": "2.1.10",
    "@rsbuild/plugin-react": "2.0.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "20.0.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
