{
  "name": "binpm-docs",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:app": "echo 'binpm-docs: no prepare step'",
    "dev": "node ../../scripts/run-rspress-port.mjs binpm-docs dev 46304 -",
