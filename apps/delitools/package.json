{
  "name": "delitools",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "dev:desktop": "node ../../scripts/tauri-cli.mjs -- dev",
    "build": "rsbuild build",
    "build:frontend": "rsbuild build",
    "build:native": "node ../../scripts/tauri-cli.mjs -- build --no-bundle",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs && pnpm typecheck && pnpm build",
    "ci:checks": "pnpm test",
    "mobile:android:init": "node scripts/mobile.mjs android init",
    "mobile:ios:init": "node scripts/mobile.mjs ios init",
    "dev:android": "node scripts/mobile.mjs android dev",
    "dev:ios": "node scripts/mobile.mjs ios dev",
    "build:android": "node scripts/mobile.mjs android build",
    "build:ios": "node scripts/mobile.mjs ios build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@rsbuild/core": "2.1.10",
    "@rsbuild/plugin-react": "2.0.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
