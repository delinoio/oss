{
  "name": "@aiprouter/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "pnpm i18n:check && rsbuild build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm i18n:check && node --test scripts/*.test.mjs && rstest",
    "i18n:check": "node scripts/check-localization.mjs",
    "i18n:translate": "node ../../scripts/localization/cli.mjs translate"
  },
  "dependencies": {
    "@aiprouter/client": "workspace:*",
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-query": "2.3.1",
    "@connectrpc/connect-web": "2.2.0",
    "@tanstack/react-query": "5.105.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@rsbuild/core": "2.2.14",
    "@rsbuild/plugin-react": "2.1.1",
    "@rstest/core": "0.12.5",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "typescript": "7.0.2"
  }
}
