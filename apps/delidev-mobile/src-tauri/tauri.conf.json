{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeliDev",
  "version": "0.1.0",
  "identifier": "io.delino.delidev.mobile",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:46312",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeliDev",
        "create": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https:; img-src 'self' data:; font-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "iOS": {
      "minimumSystemVersion": "18.0",
      "bundleVersion": "1"
    },
    "android": {
      "minSdkVersion": 31,
      "versionCode": 1
    }
  }
}
