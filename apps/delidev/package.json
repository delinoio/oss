{
  "name": "delidev-desktop",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "rsbuild dev",
    "dev:qa": "node scripts/qa/run.mjs",
    "test:qa": "node --test scripts/qa/*.test.mjs",
    "test:qa:browser": "node scripts/qa/test-browser.mjs",
    "build": "pnpm prepare:localization && rsbuild build",
    "build:frontend": "pnpm prepare:localization && rsbuild build",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm typecheck",
    "test": "pnpm --filter @delinoio/delidev-api-client build && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm test:bundle-dry-run && pnpm test:desktop-launch && pnpm test:widget && pnpm test:qa && pnpm build && node scripts/qa/check-release.mjs",
    "test:unit": "vitest run --exclude \"**/*.integration.test.*\"",
    "prepare:assets": "pnpm prepare:localization && node scripts/prepare-assets.mjs",
    "prepare:sidecar": "node scripts/prepare-sidecar.mjs",
    "prepare:widget": "pnpm prepare:localization && node scripts/build-widget.mjs",
    "test:widget": "pnpm prepare:localization && node scripts/test-widget.mjs && node scripts/test-widget-layout.mjs",
    "build:native": "pnpm prepare:assets && pnpm --filter @delinoio/delidev-api-client build && pnpm build && pnpm prepare:sidecar && pnpm prepare:widget && cargo build --manifest-path src-tauri/Cargo.toml --features desktop-host,custom-protocol --bin delidev-desktop",
    "dev:desktop": "node scripts/run-desktop.mjs",
    "dev:signing": "node scripts/development-signing.mjs",
    "bundle:native": "pnpm prepare:assets && pnpm --filter @delinoio/delidev-api-client build && pnpm build && pnpm prepare:sidecar && pnpm prepare:widget && node ../../scripts/tauri-cli.mjs -- build --features desktop-host,custom-protocol",
    "bundle:macos-dry-run": "node scripts/bundle-macos-dry-run.mjs",
    "bundle:dry-run": "node scripts/bundle-native-dry-run.mjs",
    "test:bundle-dry-run": "node --test scripts/bundle-macos-dry-run.test.mjs scripts/native-package.test.mjs scripts/bundle-updater-dry-run.test.mjs",
    "test:desktop-launch": "node --test scripts/run-desktop.test.mjs scripts/development-signing.test.mjs scripts/prepare-assets.test.mjs scripts/localization-output.test.mjs",
    "bundle:updater-dry-run": "node scripts/bundle-updater-dry-run.mjs",
    "prepare:localization": "node scripts/generate-localization.mjs",
    "test:localization": "node scripts/generate-localization.mjs --check && node --test scripts/localization.test.mjs scripts/localization-output.test.mjs",
    "test:integration": "vitest run .integration.test.",
    "ci:release": "node scripts/qa/check-release.mjs",
    "test:ci:checks": "pnpm typecheck && pnpm test:bundle-dry-run && pnpm test:desktop-launch && pnpm test:widget && pnpm test:qa && pnpm build && node scripts/qa/check-release.mjs",
    "test:ci:tests-1": "vitest run --shard=1/2",
    "test:ci:tests-2": "vitest run --shard=2/2",
    "test:unit:1": "vitest run --exclude \"**/*.integration.test.*\" --shard=1/2",
    "test:unit:2": "vitest run --exclude \"**/*.integration.test.*\" --shard=2/2",
    "test:integration:1": "vitest run .integration.test. --shard=1/2",
    "test:integration:2": "vitest run .integration.test. --shard=2/2",
    "ci:qa": "node --test scripts/qa/*.test.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.0",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-query": "2.3.1",
    "@delinoio/delidev-api-client": "workspace:*",
    "@tanstack/react-query": "5.101.4",
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "i18next": "26.4.2",
    "react-i18next": "17.0.15"
  },
  "devDependencies": {
    "@rsbuild/core": "2.1.10",
    "@rsbuild/plugin-react": "2.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "20.0.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
