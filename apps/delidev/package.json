{
  "name": "delidev-desktop",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "dev:desktop": "node ../../scripts/tauri-cli.mjs -- dev",
