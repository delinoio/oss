{
  "name": "delidev-desktop",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "rsbuild dev",
    "build": "rsbuild build",
    "build:frontend": "rsbuild build",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm typecheck",
    "test": "pnpm --filter @delinoio/delidev-api-client build && pnpm typecheck && vitest run && pnpm test:bundle-dry-run && pnpm test:desktop-launch && pnpm test:widget && pnpm build",
    "test:unit": "vitest run",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "prepare:sidecar": "node scripts/prepare-sidecar.mjs",
    "prepare:widget": "node scripts/build-widget.mjs",
    "test:widget": "node scripts/test-widget.mjs",
    "build:native": "pnpm prepare:assets && pnpm --filter @delinoio/delidev-api-client build && pnpm build && pnpm prepare:sidecar && pnpm prepare:widget && cargo build --manifest-path src-tauri/Cargo.toml --features desktop-host,custom-protocol --bin delidev-desktop",
    "dev:desktop": "node scripts/run-desktop.mjs",
    "bundle:native": "pnpm prepare:assets && pnpm --filter @delinoio/delidev-api-client build && pnpm build && pnpm prepare:sidecar && pnpm prepare:widget && node ../../scripts/tauri-cli.mjs -- build --features desktop-host,custom-protocol",
    "bundle:macos-dry-run": "node scripts/bundle-macos-dry-run.mjs",
    "bundle:dry-run": "node scripts/bundle-native-dry-run.mjs",
    "test:bundle-dry-run": "node --test scripts/bundle-macos-dry-run.test.mjs scripts/native-package.test.mjs scripts/bundle-updater-dry-run.test.mjs",
    "test:desktop-launch": "node --test scripts/run-desktop.test.mjs scripts/prepare-assets.test.mjs",
    "bundle:updater-dry-run": "node scripts/bundle-updater-dry-run.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.0",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-query": "2.3.1",
    "@delinoio/delidev-api-client": "workspace:*",
    "@tanstack/react-query": "5.101.4",
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@rsbuild/core": "2.2.11",
    "@rsbuild/plugin-react": "2.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "20.0.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
