    "test": "pnpm typecheck && pnpm build",
    "ci:checks": "pnpm test"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@rsbuild/core": "2.1.10",
    "@rsbuild/plugin-react": "2.0.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
