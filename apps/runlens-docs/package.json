{
  "name": "runlens-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:app": "echo 'runlens-docs: no prepare step'",
    "dev": "node ../../scripts/run-rspress-port.mjs runlens-docs dev 46310 -",
