{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "externalBin": ["binaries/devhud-native-messaging-host"],
    "macOS": {
      "signingIdentity": null,
      "hardenedRuntime": true,
      "entitlements": "Entitlements.release.plist"
    },
    "windows": {
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File windows/sign.ps1 %1",
      "wix": {
        "fragmentPaths": ["./windows/native-messaging-lifecycle.wxs"]
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
