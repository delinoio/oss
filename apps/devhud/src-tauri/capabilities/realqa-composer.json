{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "realqa-composer",
  "description": "Allows only the authenticated RealQA composer window to sanitize images and maintain its bounded in-memory encoded-image session.",
  "local": true,
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["realqa-composer"],
  "permissions": [
    "allow-realqa-composer-accept-image",
    "allow-realqa-composer-flatten-image",
    "allow-realqa-composer-remove-image",
    "allow-realqa-composer-reset-session"
  ]
}
