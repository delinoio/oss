{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-main",
  "description": "Allows only DevHud's desktop HUD to use its bundled shell lifecycle plus authenticated Deck Connect, exact PR handoff, and unified shortcut synchronization.",
  "local": true,
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["main"],
  "permissions": [
    "allow-get-runtime-info",
    "allow-read-settings",
    "allow-read-widget-configuration",
    "allow-hide-hud",
    "allow-show-settings",
    "allow-deck-connect",
    "allow-deck-device-id",
    "allow-deck-open-pull-request",
    "allow-synchronize-deck-shortcuts",
    "allow-get-auth-session",
    "allow-start-authentication",
    "allow-logout-authentication"
  ]
}
