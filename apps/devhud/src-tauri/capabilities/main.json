{
  "identifier": "main",
  "description": "Allows the DevHud main window to read runtime information and its two versioned local records.",
  "local": true,
  "platforms": ["linux", "macOS", "windows", "iOS", "android"],
  "windows": ["main"],
  "permissions": [
    "allow-get-runtime-info",
    "allow-read-settings",
    "allow-write-settings",
    "allow-read-widget-configuration",
    "allow-write-widget-configuration"
  ]
}
