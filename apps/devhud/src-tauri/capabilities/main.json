{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Allows only DevHud's HUD and settings windows to use the production shell and its two versioned local records.",
  "local": true,
  "windows": ["main", "settings"],
  "permissions": [
    "allow-get-runtime-info",
    "allow-read-settings",
    "allow-write-settings",
    "allow-read-widget-configuration",
    "allow-write-widget-configuration",
    "allow-show-hud",
    "allow-hide-hud",
    "allow-show-settings",
    "allow-hide-settings",
    "allow-replace-global-shortcut",
    "allow-set-launch-at-login",
    "allow-complete-first-run",
    "allow-request-update-action"
  ]
}
