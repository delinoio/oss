{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Allows only DevHud's HUD window to use its runtime, local records, and HUD lifecycle commands.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-get-runtime-info",
    "allow-read-settings",
    "allow-write-settings",
    "allow-read-widget-configuration",
    "allow-write-widget-configuration",
    "allow-hide-hud",
    "allow-show-settings"
  ]
}
