{
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "public/**",
        "src/**",
        "package.json",
        "rsbuild.config.ts",
        "tsconfig.json"
      ],
      "outputs": ["dist/**"]
    },
    "build:desktop": {
      "cache": false
    },
    "build:android": {
      "cache": false
    },
    "build:android:ci": {
      "cache": false
    },
    "build:ios": {
      "cache": false
    },
    "build:ios:ci": {
      "cache": false
    },
    "build:widget:android": {
      "cache": false
    },
    "build:widget:ios": {
      "cache": false
    },
    "check:mobile": {
      "cache": false
    },
    "check:rust": {
      "cache": false
    },
    "check:security": {
      "cache": false
    },
    "check:widget-artifacts": {
      "cache": false
    },
    "ci:deck:frontend": {
      "cache": false,
      "outputs": ["dist/**"]
    },
    "ci:deck:auth-smoke": {
      "cache": false,
      "outputs": ["dist/**"]
    },
    "ci:deck:widget-policy": {
      "cache": false
    },
    "ci:deck:widget:android": {
      "cache": false,
      "passThroughEnv": ["ANDROID_HOME", "ANDROID_SDK_ROOT"]
    },
    "ci:deck:widget:ios": {
      "cache": false
    },
    "ci:realqa:frontend": {
      "cache": false,
      "outputs": ["dist/**"]
    },
    "ci:realqa:rust": {
      "cache": false
    },
    "ci:realqa:linux": {
      "cache": false
    },
    "ci:realqa:extension": {
      "cache": false
    },
    "ci:realqa:fixture-artifacts": {
      "cache": false,
      "outputs": ["build/realqa-fixtures/**"]
    },
    "test:mobile": {
      "cache": false
    },
    "test:security": {
      "cache": false
    },
    "test:android:native": {
      "cache": false
    },
    "test:widget:android": {
      "cache": false
    },
    "test:widget:ios": {
      "cache": false
    },
    "smoke:desktop": {
      "cache": false
    }
  }
}
