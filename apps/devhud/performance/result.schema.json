{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.deli/schemas/devhud-performance-result-v1.json",
  "title": "DevHud performance result",
  "type": "object",
  "required": ["schemaVersion", "application", "targets"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "devhud.performance.result.v1" },
    "application": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "tauriRevision", "cefRevision"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" },
        "tauriRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "cefRevision": { "type": "string", "pattern": "^tauri-runtime-cef@[0-9a-f]{40}$" }
      }
    },
    "targets": { "type": "array", "items": { "$ref": "#/$defs/target" } }
  },
  "$defs": {
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "architecture", "status", "measurements"],
      "properties": {
        "platform": { "enum": ["linux", "macos", "windows", "android", "ios"] },
        "architecture": { "enum": ["x86_64", "arm64", "armv7"] },
        "status": { "enum": ["available", "unavailable", "failed"] },
        "unavailableReason": { "type": "string", "enum": ["unsupported-host", "no-display-server", "tool-not-installed", "no-supported-target", "artifact-not-found"] },
        "failure": { "type": "string", "enum": ["build-failed", "launch-failed", "measurement-protocol-failed", "startup-timeout", "startup-exited"] },
        "measurements": { "type": "array", "items": { "$ref": "#/$defs/measurement" } }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "unavailable" } }, "required": ["status"] }, "then": { "required": ["unavailableReason"], "not": { "required": ["failure"] } } },
        { "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] }, "then": { "required": ["failure"], "not": { "required": ["unavailableReason"] } } },
        { "if": { "properties": { "status": { "const": "available" } }, "required": ["status"] }, "then": { "not": { "anyOf": [{ "required": ["unavailableReason"] }, { "required": ["failure"] }] } } },
        { "if": { "properties": { "platform": { "enum": ["linux", "macos", "windows", "ios"] } }, "required": ["platform"] }, "then": { "properties": { "architecture": { "enum": ["x86_64", "arm64"] } } } },
        { "if": { "properties": { "platform": { "const": "android" } }, "required": ["platform"] }, "then": { "properties": { "measurements": { "items": { "allOf": [{ "$ref": "#/$defs/measurement" }, { "if": { "properties": { "name": { "const": "mobile-startup" } }, "required": ["name"] }, "then": { "properties": { "method": { "const": "adb-am-start-w" } } } }] } } } } },
        { "if": { "properties": { "platform": { "const": "ios" } }, "required": ["platform"] }, "then": { "properties": { "measurements": { "items": { "allOf": [{ "$ref": "#/$defs/measurement" }, { "if": { "properties": { "name": { "const": "mobile-startup" } }, "required": ["name"] }, "then": { "properties": { "method": { "enum": ["simctl-launch-wall-clock", "devicectl-launch-wall-clock"] } } } }] } } } } },
        { "if": { "properties": { "status": { "const": "available" }, "platform": { "enum": ["linux", "macos", "windows"] } }, "required": ["status", "platform"] }, "then": { "properties": { "measurements": { "allOf": [
          { "contains": { "type": "object", "properties": { "name": { "const": "desktop-cold-startup" }, "status": { "const": "available" } }, "required": ["name", "status"] } },
          { "contains": { "type": "object", "properties": { "name": { "const": "desktop-warm-startup" }, "status": { "const": "available" } }, "required": ["name", "status"] } },
          { "contains": { "type": "object", "properties": { "name": { "const": "desktop-hud-display" }, "status": { "const": "available" } }, "required": ["name", "status"] } },
          { "contains": { "type": "object", "properties": { "name": { "const": "desktop-package-size" }, "status": { "const": "available" } }, "required": ["name", "status"] } },
          { "contains": { "type": "object", "properties": { "name": { "const": "desktop-idle-memory" }, "status": { "const": "available" } }, "required": ["name", "status"] } }
        ] } } } },
        { "if": { "properties": { "status": { "const": "available" }, "platform": { "enum": ["android", "ios"] } }, "required": ["status", "platform"] }, "then": { "properties": { "measurements": { "contains": { "type": "object", "properties": { "name": { "const": "mobile-startup" }, "status": { "const": "available" } }, "required": ["name", "status"] } } } } }
      ]
    },
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "status", "method", "samples"],
      "properties": {
        "name": { "enum": ["desktop-cold-startup", "desktop-warm-startup", "desktop-hud-display", "desktop-package-size", "desktop-idle-memory", "mobile-startup"] },
        "status": { "enum": ["available", "unavailable", "failed"] },
        "method": { "type": "string", "enum": ["process-ready-marker", "process-hud-marker", "artifact-byte-count", "resident-set-sampling", "adb-am-start-w", "simctl-launch-wall-clock", "devicectl-launch-wall-clock"] },
        "samples": { "type": "array", "items": { "type": "number", "minimum": 0 } },
        "unit": { "enum": ["milliseconds", "bytes"] },
        "note": { "type": "string", "enum": ["cold-process", "warm-process", "explicit-hud-invocation", "packaged-artifact", "post-ready-idle"] }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "available" } }, "required": ["status"] }, "then": { "required": ["unit"], "properties": { "samples": { "minItems": 1 } } } },
        { "if": { "properties": { "name": { "enum": ["desktop-cold-startup", "desktop-warm-startup"] } }, "required": ["name"] }, "then": { "properties": { "method": { "const": "process-ready-marker" } } } },
        { "if": { "properties": { "name": { "const": "desktop-hud-display" } }, "required": ["name"] }, "then": { "properties": { "method": { "const": "process-hud-marker" } } } },
        { "if": { "properties": { "name": { "const": "desktop-package-size" } }, "required": ["name"] }, "then": { "properties": { "method": { "const": "artifact-byte-count" } } } },
        { "if": { "properties": { "name": { "const": "desktop-idle-memory" } }, "required": ["name"] }, "then": { "properties": { "method": { "const": "resident-set-sampling" } } } },
        { "if": { "properties": { "status": { "const": "available" }, "name": { "enum": ["desktop-package-size", "desktop-idle-memory"] } }, "required": ["status", "name"] }, "then": { "properties": { "unit": { "const": "bytes" } } } },
        { "if": { "properties": { "status": { "const": "available" }, "name": { "enum": ["desktop-cold-startup", "desktop-warm-startup", "desktop-hud-display", "mobile-startup"] } }, "required": ["status", "name"] }, "then": { "properties": { "unit": { "const": "milliseconds" } } } }
      ]
    }
  }
}
