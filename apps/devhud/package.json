{
  "name": "devhud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rsbuild build",
    "build:android": "node scripts/mobile.mjs build android production",
    "build:android:ci": "node scripts/mobile.mjs build android ci",
    "build:desktop": "pnpm run build && tauri build --debug --no-bundle --features desktop-cef,custom-protocol",
    "build:preview": "pnpm run build && tauri build --features desktop-cef,custom-protocol",
    "build:ios": "node scripts/mobile.mjs build ios production",
    "build:ios:ci": "node scripts/mobile.mjs build ios ci",
    "assets": "node scripts/generate-assets.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "build:widget:android": "node scripts/widget-native.mjs android build",
    "build:widget:ios": "node scripts/widget-native.mjs ios build",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:diagnostics": "node scripts/check-diagnostics.mjs",
    "check:locks": "node scripts/check-lockfiles.mjs",
    "check:mobile": "node scripts/check-mobile-contracts.mjs",
    "check:rust": "node scripts/run-cargo-checks.mjs",
    "check:security": "node scripts/check-security.mjs",
    "check:widget-artifacts": "node scripts/check-widget-artifacts.mjs",
    "dev": "rsbuild dev",
    "lint": "eslint . --max-warnings 0",
    "mobile:generate:android": "node scripts/mobile.mjs generate android",
    "mobile:generate:ios": "node scripts/mobile.mjs generate ios",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "test": "vitest run",
    "test:diagnostics": "pnpm run check:diagnostics && vitest run src/runtime/startup.test.ts src/App.ui.test.tsx && cargo test -p devhud",
    "test:android:native": "pnpm run build:android:ci && node scripts/android-native-test.mjs",
    "test:a11y": "vitest run src/App.ui.test.tsx src/realqa/editor/ScreenshotEditor.test.tsx",
    "test:build": "node scripts/check-build-reproducibility.mjs",
    "test:mobile": "pnpm run build && vitest run src/App.ui.test.tsx src/runtime/platform.test.ts && pnpm run check:mobile",
    "test:realqa": "vitest run src/realqa",
    "test:realqa:native": "node scripts/test-realqa-native.mjs",
    "test:security": "pnpm run build && pnpm run check:security",
    "test:widget:android": "node scripts/widget-native.mjs android test",
    "test:widget:ios": "node scripts/widget-native.mjs ios test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@rsbuild/core": "2.1.7",
    "@rsbuild/plugin-react": "2.1.0",
    "@tauri-apps/cli-cef": "3.0.0-alpha.6",
    "@tauri-apps/cli-mobile": "npm:@tauri-apps/cli@2.11.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.53.1",
    "@typescript-eslint/parser": "8.53.1",
    "axe-core": "4.11.1",
    "eslint": "9.39.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "17.4.0",
    "jsdom": "28.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
