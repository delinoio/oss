{
  "$schema": "https://turbo.build/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/devhud/src-tauri/icons/icon.png"
      ]
    },
    "build:frontend": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/devhud/src-tauri/icons/icon.png"
      ]
    },
    "ci:policy": {
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.nvmrc",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/rust-toolchain",
        "$TURBO_ROOT$/go.mod",
        "$TURBO_ROOT$/go.sum"
      ],
      "outputs": [],
      "env": [
        "CI_CACHE_CONTEXT"
      ]
    },
    "test:package": {
      "cache": false,
      "dependsOn": [
        "build:test"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.nvmrc",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/rust-toolchain",
        "$TURBO_ROOT$/go.mod",
        "$TURBO_ROOT$/go.sum"
      ],
      "outputs": []
    },
    "build:test": {
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.nvmrc",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/rust-toolchain",
        "$TURBO_ROOT$/go.mod",
        "$TURBO_ROOT$/go.sum",
        "$TURBO_ROOT$/apps/devhud/src-tauri/icons/icon.png"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        "artifacts/**"
      ],
      "env": [
        "CI_CACHE_CONTEXT"
      ]
    },
    "ci:zip": {
      "cache": true,
      "dependsOn": [
        "test:package"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.nvmrc",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/rust-toolchain",
        "$TURBO_ROOT$/go.mod",
        "$TURBO_ROOT$/go.sum"
      ],
      "outputs": [],
      "env": [
        "CI_CACHE_CONTEXT"
      ]
    },
    "ci:check": {
      "cache": false,
      "dependsOn": [
        "typecheck",
        "test:unit",
        "ci:policy",
        "test:package",
        "ci:zip"
      ]
    }
  }
}
