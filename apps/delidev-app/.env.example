# Browser-safe values only. Never put Logto client secrets or access tokens here.
PUBLIC_DELIBASE_API_ORIGIN=https://delibase.deli.dev
PUBLIC_LOGTO_ENDPOINT=https://your-tenant.logto.app
PUBLIC_LOGTO_APP_ID=your-spa-application-id
PUBLIC_LOGTO_AUDIENCE=https://delibase.deli.dev
PUBLIC_DECK_API_ORIGIN=https://deck.deli.dev
PUBLIC_DECK_LOGTO_AUDIENCE=https://deck.deli.dev
PUBLIC_DECK_GITHUB_APP_CLIENT_ID=your-deck-github-app-client-id
PUBLIC_DECK_GITHUB_APP_SLUG=your-deck-github-app-slug
PUBLIC_DECK_GITHUB_CALLBACK_URI=https://deck.deli.dev/github/oauth/callback
PUBLIC_REALQA_API_ORIGIN=https://realqa.deli.dev
PUBLIC_REALQA_LOGTO_AUDIENCE=https://realqa.deli.dev
PUBLIC_REALQA_GITHUB_APP_CLIENT_ID=your-realqa-github-app-client-id
PUBLIC_REALQA_GITHUB_APP_SLUG=your-realqa-github-app-slug
PUBLIC_REALQA_GITHUB_CALLBACK_URI=https://realqa.deli.dev/github/oauth/callback
# Public verified-link identities. Artifact builds fail when either is absent or malformed.
DELIDEV_DEVHUD_APPLE_TEAM_ID=your-10-character-apple-team-id
DELIDEV_DEVHUD_ANDROID_CERTIFICATE_SHA256=your-android-release-certificate-sha256
